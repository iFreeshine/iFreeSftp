<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="iFreeSftp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:iFreeSftp">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!--
                图标按钮 tooltip: 蓝色背景白字, 显示在图标下方 (PlacementMode=Bottom)。
                默认 ToolTip 模板绑定主题资源灰底, 用显式模板保证样式生效。
            -->
            <Style x:Key="AccentToolTipStyle" TargetType="ToolTip">
                <Setter Property="Background" Value="#0078D4" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="10,5,10,6" />
                <Setter Property="Placement" Value="Bottom" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Other app resources here -->
            <!--
                输入框文字垂直居中: 实测 (像素级) WinUI TextBox 模板并未把
                VerticalContentAlignment 绑定到内容 (设置无效), 文字在内边距圈出的
                区域内顶部对齐, 偏差只由上内边距决定。默认 TextControlThemePadding
                (10,5,10,6) 上边距 5 使 12px 字号文字中心偏高约 3.7 逻辑像素;
                上边距 7 时墨迹中心与框中心重合 (偏差 <1 物理像素), 全应用生效。
                (WinUI 隐式 Style 未设置的属性仍回落默认样式, 不会丢模板。)
            -->
            <Thickness x:Key="TextControlThemePadding">10,7,10,4</Thickness>
            <Style TargetType="TextBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style TargetType="NumberBox">
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <!--
                区域配色: 亮主题 header 主背景深一档 (#E9E9E9)、容器内容区浅一档
                (#F9F9F9); 暗主题 header (#26303D) 浅一档、容器 (#1B2430) 深一档。
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- 亮主题: header 主背景 #E9E9E9 深一档, 容器内容区 #F9F9F9 浅一档
                         (2026-09 交换: 容器与 header 层次反转, 内容区更亮) -->
                    <SolidColorBrush x:Key="HeaderAreaBrush" Color="#E9E9E9" />
                    <SolidColorBrush x:Key="FolderAreaBrush" Color="#F9F9F9" />
                    <!-- 弹框标题栏背景: 亮主题加深与主标题栏一致 (同 HeaderAreaBrush 值, 改色时同步) -->
                    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#E9E9E9" />
                    <!-- 文件面板分隔线: 竖线最淡 (仅隐约可见, #EDEDED); 5 大行横线
                         #E3E3E3 比竖线强一档 (#D0D0D0→#E3E3E3 2026-09 变淡) -->
                    <SolidColorBrush x:Key="SeparatorLineBrush" Color="#EDEDED" />
                    <SolidColorBrush x:Key="RowSeparatorLineBrush" Color="#E3E3E3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="HeaderAreaBrush" Color="#26303D" />
                    <SolidColorBrush x:Key="FolderAreaBrush" Color="#1B2430" />
                    <!-- 弹框标题栏背景: 暗主题不加深, 保持卡片底色 (同 FolderAreaBrush 值, 改色时同步;
                         2026-09-30 用户确认仅亮主题加深) -->
                    <SolidColorBrush x:Key="DialogTitleBarBrush" Color="#1B2430" />
                    <!-- 竖线最淡 (仅隐约可见); 5 大行横线比竖线强一档 -->
                    <SolidColorBrush x:Key="SeparatorLineBrush" Color="#202B38" />
                    <SolidColorBrush x:Key="RowSeparatorLineBrush" Color="#313F4F" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
