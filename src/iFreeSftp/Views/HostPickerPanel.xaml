<?xml version="1.0" encoding="utf-8" ?>
<!--
    打开内容选择器 (模态): 遮罩 + 居中卡片。卡片不透明 (Solid 底), 带标题栏
    (右侧关闭钮) 与投影阴影; 上半区"本地"单行, 下半区"主机"逐行列出存档主机。
    由 tab 栏 + 按钮与空状态"选择主机"按钮触发, 点击行即选择并关闭。
-->
<UserControl
    x:Class="iFreeSftp.Views.HostPickerPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PanelRoot">
        <!-- 遮罩: 点击空白关闭 (与 HostPanel 同款半透明黑) -->
        <Border x:Name="Mask" Background="#80000000" Tapped="Mask_Tapped" />

        <!-- 选择卡片: 不透明底 (DialogTitleBarBrush, 外壳与标题栏同色一体) + 标题栏拖拽 -->
        <Border
            x:Name="Card"
            Width="520"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource DialogTitleBarBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DragTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏: 与主机/设置面板同款窄标题栏, 通栏贴边 (顶部两角由卡片圆角裁剪),
                     无底部分隔线, 背景 DialogTitleBarBrush (亮=主标题栏加深, 暗=卡片底色);
                     按住空白区拖动卡片 -->
                <Grid
                    Grid.Row="0"
                    Padding="14,5,5,2"
                    ColumnSpacing="8"
                    Background="{ThemeResource DialogTitleBarBrush}"
                    PointerMoved="TitleBar_PointerMoved"
                    PointerPressed="TitleBar_PointerPressed"
                    PointerReleased="TitleBar_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="PickerTitle"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseBtn_Click">
                        <!-- hover/按下用系统悬停色 (Transparent 底默认 hover 变化太弱不可辨) -->
                        <Button.Resources>
                            <ThemeResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <ThemeResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </Button.Resources>
                        <FontIcon FontSize="11" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- 内容面板: 圆弧容器, 距弹框边框 5px, 圆角 6,
                     背景 CardBackgroundFillColorDefaultBrush 随亮暗主题, 亮暗均无边框线 -->
                <Border
                    Grid.Row="1"
                    Margin="5,0,5,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="0,4">
                        <TextBlock
                            x:Name="LocalHeader"
                            Margin="16,10,16,4"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView
                            x:Name="LocalList"
                            IsItemClickEnabled="True"
                            ItemClick="LocalList_ItemClick"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10,12" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" FontSize="18" Glyph="&#xE7F8;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Hint}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- 分隔线: 本地区与主机区之间 1px 横线 (主界面横线同款 RowSeparatorLineBrush
                         随主题, 左右内缩 16 与列表内容对齐) -->
                    <Rectangle
                        Grid.Row="1"
                        Height="1"
                        Margin="16,6"
                        Fill="{ThemeResource RowSeparatorLineBrush}" />

                    <StackPanel Grid.Row="2" Padding="0,4">
                        <TextBlock
                            x:Name="HostsHeader"
                            Margin="16,12,16,4"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <!-- 主机列表区: 基础高度 440 (增高, 不随主机数缩矮), 超过 540 出独立滚动条 -->
                        <ScrollViewer
                            MinHeight="440"
                            MaxHeight="540"
                            VerticalScrollBarVisibility="Visible">
                            <StackPanel>
                                <ListView
                                    x:Name="HostRows"
                                    IsItemClickEnabled="True"
                                    ItemClick="HostRows_ItemClick"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="10,10" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 橙色圆角图标块 (服务器), 与参考稿一致 -->
                                                <Border
                                                    Grid.Column="0"
                                                    Width="28"
                                                    Height="28"
                                                    Background="#E95420"
                                                    CornerRadius="6">
                                                    <FontIcon FontSize="13" Foreground="White" Glyph="&#xE968;" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock
                                    x:Name="EmptyHint"
                                    Margin="16,4,16,14"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Visibility="Collapsed" />
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
