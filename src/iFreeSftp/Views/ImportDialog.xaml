<?xml version="1.0" encoding="utf-8" ?>
<!--
    会话导入向导弹窗 (模态): 遮罩 + 居中卡片, 三态 = 同意页 → 预览表(判重) → 结果页。
    解析/判重走 HostImportParser (三条红线: 口令不导、命令字段不导、只导连接元数据),
    勾选条目经 ImportRequested 回调交由宿主 HostPanel 写回 HostStoreService。
    样式遵循 README 3.9 弹框统一原则: 窄标题栏通栏 + 关闭钮 hover、卡片 CornerRadius=8
    描边、内容圆弧容器、ESC/遮罩/关闭钮均可关闭、标题栏可拖拽、打开时重置拖拽偏移。
-->
<UserControl
    x:Class="iFreeSftp.Views.ImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:iFreeSftp.Views"
    mc:Ignorable="d">

    <Grid x:Name="PanelRoot">
        <!-- 遮罩: 点击空白关闭 (与 HostPanel/PermissionDialog 同款半透明黑) -->
        <Border x:Name="Mask" Background="#80000000" Tapped="Mask_Tapped" />

        <!-- 卡片: 不透明底 (DialogTitleBarBrush, 外壳与标题栏同色一体) + 标题栏拖拽;
             宽 680: 预览表 7 列 (选择/名称/主机/端口/用户名/认证/状态) 需要横向空间 -->
        <Border
            x:Name="Card"
            Width="680"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource DialogTitleBarBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DragTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏: 窄标题栏通栏贴边 (顶部两角由卡片圆角裁剪), 无底部分隔线;
                     按住空白区拖动卡片 -->
                <Grid
                    Grid.Row="0"
                    Padding="14,5,5,2"
                    ColumnSpacing="8"
                    Background="{ThemeResource DialogTitleBarBrush}"
                    PointerMoved="TitleBar_PointerMoved"
                    PointerPressed="TitleBar_PointerPressed"
                    PointerReleased="TitleBar_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseBtn_Click">
                        <!-- hover/按下用系统悬停色 (Transparent 底默认 hover 变化太弱不可辨) -->
                        <Button.Resources>
                            <ThemeResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <ThemeResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </Button.Resources>
                        <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- 内容面板: 圆弧容器, 距弹框边框 5px, 圆角 6,
                     背景 CardBackgroundFillColorDefaultBrush 随亮暗主题, 亮暗均无边框线 -->
                <Border
                    Grid.Row="1"
                    Margin="5,0,5,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6">
                    <Grid>

                        <!-- 态 1: 同意页 - 隐私说明 + 来源选择 + 显式同意 + 扫描 -->
                        <StackPanel x:Name="ConsentView" Padding="16,12" Spacing="12">
                            <TextBlock
                                x:Name="PrivacyNote"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SourcesHeader"
                                FontSize="12"
                                FontWeight="SemiBold" />
                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox x:Name="WinScpIniCb" Grid.Row="0" Grid.Column="0" IsChecked="True" />
                                <CheckBox x:Name="WinScpRegCb" Grid.Row="0" Grid.Column="1" IsChecked="True" />
                                <CheckBox x:Name="FileZillaCb" Grid.Row="1" Grid.Column="0" IsChecked="True" />
                                <CheckBox x:Name="PuTTYCb" Grid.Row="1" Grid.Column="1" IsChecked="True" />
                                <CheckBox x:Name="OpenSshCb" Grid.Row="2" Grid.Column="0" IsChecked="True" />
                                <CheckBox x:Name="OwnStoreCb" Grid.Row="2" Grid.Column="1" IsChecked="True" />
                            </Grid>
                            <CheckBox
                                x:Name="ConsentCb"
                                Checked="ConsentCb_Changed"
                                Unchecked="ConsentCb_Changed" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ScanBtn"
                                    IsEnabled="False"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ScanBtn_Click" />
                                <Button x:Name="CancelBtn" Click="CancelBtn_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 态 2: 预览页 - 概要 + 判重/警告标记表 + 勾选后导入 -->
                        <StackPanel
                            x:Name="PreviewView"
                            Padding="16,12"
                            Spacing="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="SummaryText"
                                FontSize="12"
                                TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="96" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="ColName"
                                    Grid.Column="1"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ColHost"
                                    Grid.Column="2"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ColPort"
                                    Grid.Column="3"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ColUser"
                                    Grid.Column="4"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ColAuth"
                                    Grid.Column="5"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock
                                    x:Name="ColStatus"
                                    Grid.Column="6"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ListView
                                x:Name="PreviewList"
                                MaxHeight="320"
                                IsItemClickEnabled="False"
                                SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="MinHeight" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="views:ImportRow">
                                        <!-- 列定义必须与上方列头 Grid 一致 -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="88" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="96" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox
                                                Grid.Column="0"
                                                MinWidth="0"
                                                HorizontalAlignment="Center"
                                                IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind Name, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind HostText, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind PortText, Mode=OneTime}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind UsernameText, Mode=OneTime}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="5"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind AuthText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Grid.Column="6"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{x:Bind StatusText, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="WarnText"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ImportBtn"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="ImportBtn_Click" />
                                <Button x:Name="BackBtn" Click="BackBtn_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- 态 3: 结果页 - 计数三态 (成功 N 条 / 无新会话) + 错误明细 -->
                        <StackPanel
                            x:Name="ResultView"
                            Padding="16,12"
                            Spacing="14"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon
                                    x:Name="ResultIcon"
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    x:Name="ResultText"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock
                                x:Name="ResultDetailText"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="DoneBtn"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="DoneBtn_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
