<?xml version="1.0" encoding="utf-8" ?>
<!--
    删除确认弹窗 (模态): 遮罩 + 居中卡片, 样式与 PermissionDialog/ChecksumDialog
    同构 (README 3.9 弹框统一原则 + 小弹框字号口径): 标题 14 SemiBold /
    关闭钮图标 10 / 名称 50% 淡化 / 说明文字 14。
    单项显示该名称, 多项显示"首名 + 等 N 项", 不罗列全部文件名;
    删除按钮红色文字 (危险操作), ESC/遮罩/关闭钮均可取消。
-->
<UserControl
    x:Class="iFreeSftp.Views.DeleteConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="PanelRoot">
        <!-- 遮罩: 点击空白取消 (与 HostPanel/HostPickerPanel 同款半透明黑) -->
        <Border x:Name="Mask" Background="#80000000" Tapped="Mask_Tapped" />

        <!-- 卡片: 不透明底 (DialogTitleBarBrush, 外壳与标题栏同色一体) + 标题栏拖拽 -->
        <Border
            x:Name="Card"
            Width="320"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{ThemeResource DialogTitleBarBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DragTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题栏: 小弹框口径 (标题 14 / 关闭图标 10) -->
                <Grid
                    Grid.Row="0"
                    Padding="14,5,5,2"
                    ColumnSpacing="8"
                    Background="{ThemeResource DialogTitleBarBrush}"
                    PointerMoved="TitleBar_PointerMoved"
                    PointerPressed="TitleBar_PointerPressed"
                    PointerReleased="TitleBar_PointerReleased">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TitleText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseBtn_Click">
                        <Button.Resources>
                            <ThemeResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                            <ThemeResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                        </Button.Resources>
                        <FontIcon FontSize="10" Glyph="&#xE8BB;" />
                    </Button>
                </Grid>

                <!-- 内容面板: 圆弧容器 -->
                <Border
                    Grid.Row="1"
                    Margin="5,0,5,5"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="6">
                    <StackPanel Padding="16,12" Spacing="14">

                        <!-- 条目行: 删除图标 (危险红) + 名称 (50% 淡化, 多项=首名+等 N 项) -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                Glyph="&#xE74D;" />
                            <TextBlock
                                x:Name="EntryName"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Opacity="0.5"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- 说明文字 -->
                        <TextBlock
                            x:Name="BodyText"
                            FontSize="14"
                            TextWrapping="Wrap" />

                        <!-- 操作按钮: 删除 (危险红字) / 取消 -->
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <!-- 删除 = 危险操作: 红色文字 (右键菜单删除项同口径) -->
                            <Button
                                x:Name="DeleteBtn"
                                Click="DeleteBtn_Click"
                                Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                            <Button x:Name="CancelBtn" Click="CancelBtn_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
