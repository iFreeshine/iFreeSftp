<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="iFreeSftp.Views.MainContainer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:views="using:iFreeSftp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        主容器: header 下面的整个内容区域。上排并排两个文件夹容器, 下排并排
        上传队列容器与终端容器 (初始高 60px)。打底/边框/分隔条用与 header 相同
        的较浅色, 四个内容容器用深一档色并开启圆弧角 (画刷定义见 App.xaml,
        暗主题为 WinUI 深蓝色系)。横竖间隔宽度一致 (6px), 两条分隔条分别支持
        拖拽调节左右列宽与下排行高。
    -->
    <Border
        Background="{ThemeResource HeaderAreaBrush}"
        BorderBrush="{ThemeResource HeaderAreaBrush}"
        BorderThickness="5,0,5,5">
        <Grid x:Name="ContentGrid" ColumnSpacing="0" RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="6" />
                <RowDefinition Height="120" />
            </Grid.RowDefinitions>

            <!-- 上排: 左右文件夹容器 (圆角) -->
            <Border
                Grid.Row="0"
                Grid.Column="0"
                Background="{ThemeResource FolderAreaBrush}"
                CornerRadius="8">
                <views:FolderContainer x:Name="LeftPane" PaneName="Left" />
            </Border>

            <Border
                Grid.Row="0"
                Grid.Column="2"
                Background="{ThemeResource FolderAreaBrush}"
                CornerRadius="8">
                <views:FolderContainer x:Name="RightPane" PaneName="Right" />
            </Border>

            <!--
                竖分隔条: 跨上排与下排 (拖动时左右列宽同步), 与 header/边框同色,
                hover 时仅光标变左右拖拽手势。
            -->
            <views:SplitterThumb
                x:Name="Splitter"
                Grid.Row="0"
                Grid.Column="1"
                Grid.RowSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsTabStop="False"
                Orientation="Vertical"
                Background="{ThemeResource HeaderAreaBrush}">
                <views:SplitterThumb.Template>
                    <ControlTemplate TargetType="views:SplitterThumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </views:SplitterThumb.Template>
            </views:SplitterThumb>

            <!--
                横分隔条: 分隔文件夹行与下排容器行, 间隔宽度与两文件夹间隔一致 (6px),
                拖动调节下排高度, hover 时光标变上下拖拽手势。
            -->
            <views:SplitterThumb
                x:Name="RowSplitter"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsTabStop="False"
                Orientation="Horizontal"
                Background="{ThemeResource HeaderAreaBrush}">
                <views:SplitterThumb.Template>
                    <ControlTemplate TargetType="views:SplitterThumb">
                        <Border Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </views:SplitterThumb.Template>
            </views:SplitterThumb>

            <!-- 下排: 上传队列 (左) / shell 终端 (右), 圆角容器 -->
            <Border
                Grid.Row="2"
                Grid.Column="0"
                Background="{ThemeResource FolderAreaBrush}"
                CornerRadius="8">
                <views:QueueContainer x:Name="QueuePane" />
            </Border>

            <Border
                Grid.Row="2"
                Grid.Column="2"
                Background="{ThemeResource FolderAreaBrush}"
                CornerRadius="8">
                <views:TerminalContainer x:Name="TerminalPane" />
            </Border>
        </Grid>
    </Border>
</Page>
