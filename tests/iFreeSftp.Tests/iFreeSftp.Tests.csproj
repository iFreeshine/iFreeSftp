<Project Sdk="Microsoft.NET.Sdk">

  <!-- 纯函数单测: 链接应用源码编译 (不引用 WinUI exe 工程), 保证测试与产品逻辑零漂移。
       独立运行: dotnet test tests/iFreeSftp.Tests/iFreeSftp.Tests.csproj -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 被测源码: Models 纯函数 + 无 WinUI 依赖的 Services -->
    <Compile Include="..\..\src\iFreeSftp\Models\PureHelpers.cs" Link="Linked\Models\PureHelpers.cs" />
    <Compile Include="..\..\src\iFreeSftp\Models\FileEntry.cs" Link="Linked\Models\FileEntry.cs" />
    <Compile Include="..\..\src\iFreeSftp\Models\HostProfile.cs" Link="Linked\Models\HostProfile.cs" />
    <Compile Include="..\..\src\iFreeSftp\Services\Sm3.cs" Link="Linked\Services\Sm3.cs" />
    <Compile Include="..\..\src\iFreeSftp\Services\UrlGuard.cs" Link="Linked\Services\UrlGuard.cs" />
    <Compile Include="..\..\src\iFreeSftp\Services\HostStoreService.cs" Link="Linked\Services\HostStoreService.cs" />
    <Compile Include="..\..\src\iFreeSftp\Services\HostImportParser.cs" Link="Linked\Services\HostImportParser.cs" />
    <Compile Include="..\..\src\iFreeSftp\Services\AppSettingsService.cs" Link="Linked\Services\AppSettingsService.cs" />
  </ItemGroup>

</Project>
